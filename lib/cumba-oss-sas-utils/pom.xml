<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>cumba-oss-sas-utils</artifactId>
    <packaging>jar</packaging>
    <parent>
        <groupId>net.cumba</groupId>
        <artifactId>cumba-oss-formats-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <inceptionYear>2026</inceptionYear>
    <!--
        REQUIRED by Maven Central, and it must be declared HERE: <name> is one
        of the few POM elements Maven does NOT inherit from the parent, so a
        module without its own name publishes a nameless artifact and the whole
        Central bundle is rejected with "Project name is missing".
    -->
    <name>Cumba OSS Formats :: SAS Utils</name>
    <!--
        Declared explicitly rather than inherited: the parent carries
        child.project.url.inherit.append.path="false", which was measured to fix
        the <scm> URLs but NOT the project <url> under Maven 3.9.16 — the
        effective pom still read .../lib/<module>, a 404.
    -->
    <url>https://github.com/cumba-oss/cumba-oss-formats</url>
    <description>
        Low-level reader for SAS transport (xpt) and SAS data set
        (sas7bdat) binary files, built on org.thshsh:struct. Read-only: no
        writer and no sas7bcat-catalog classes are included.
    </description>
    <organization>
        <name>P300</name>
    </organization>

    <properties>
        <mockito.agent>-javaagent:${org.mockito:mockito-core:jar}</mockito.agent>

        <!--
            Quality floors for this module, measured COLD on THIS subset (2026-09-16), not
            carried over from the internal twin: this repository ships no writer and no
            sas7bcat-catalog classes, so internal's 87 / 93 / 88 were measured over a
            different file set and do not transfer.

            Measured here: 1037 mutants, 963 KILLED, 5 TIMED_OUT, 61 SURVIVED,
            8 NO_COVERAGE -> mutation coverage 93 % (92.9 % counting only KILLED),
            test strength 94 %, pitest line coverage 96 %, JaCoCo line coverage 95.9 %.

            Each floor is the measured figure minus about two points, per the ratchet rule.
            They replace the root pom's inherited 55 / 80 / 0 and 0.80 - against which a
            measured 93 % could regress into the low 70s with every gate still green, and
            the strength gate at 0 could not fail at any score at all.

            ⛔ A floor is never lowered. If a change drops this module below one of them,
            the change is wrong or its tests are missing - do not re-base the number. Never
            pass -Dpitest.mutation.threshold or -Djacoco.line.coverage on the command line
            either; a CLI -D clobbers every module's value at once.
        -->
        <pitest.mutation.target>91</pitest.mutation.target>
        <pitest.coverage.target>94</pitest.coverage.target>
        <pitest.test.strength.target>92</pitest.test.strength.target>
        <jacoco.line.coverage>0.93</jacoco.line.coverage>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.thshsh</groupId>
            <artifactId>struct</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- JSpecify nullability annotations (NullAway). -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <reporting>
    </reporting>

</project>
