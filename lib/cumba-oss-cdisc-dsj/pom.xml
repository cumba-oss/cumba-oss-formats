<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>cumba-oss-cdisc-dsj</artifactId>
    <packaging>jar</packaging>
    <parent>
        <groupId>net.cumba</groupId>
        <artifactId>cumba-oss-formats-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <inceptionYear>2026</inceptionYear>
    <!--
        REQUIRED by Maven Central, and it must be declared HERE: <name> is one
        of the few POM elements Maven does NOT inherit from the parent, so a
        module without its own name publishes a nameless artifact and the whole
        Central bundle is rejected with "Project name is missing".
    -->
    <name>Cumba OSS Formats :: Dataset-JSON</name>
    <!--
        Declared explicitly rather than inherited: the parent carries
        child.project.url.inherit.append.path="false", which was measured to fix
        the <scm> URLs but NOT the project <url> under Maven 3.9.16 — the
        effective pom still read .../lib/<module>, a 404.
    -->
    <url>https://github.com/cumba-oss/cumba-oss-formats</url>
    <description>
        Dataset-JSON (DSJ) DTO model — Jackson beans for CDISC Dataset-JSON
        v1.x files. Standalone module used by cumba-oss-datatable-provider-dsj.
    </description>
    <organization>
        <name>P300</name>
    </organization>

    <properties>
        <!-- Repo-root anchor, depth 2 (see the root pom). -->
        <repo.root.dir>${project.basedir}/../..</repo.root.dir>

        <mockito.agent>-javaagent:${org.mockito:mockito-core:jar}</mockito.agent>

        <!--
            Quality floors for this module, set to (measured - 2) and NEVER lowered.

            Measured 2026-09-11 on a COLD pitest run (history cleared first), after the
            clinical-path test-strength pass:

              420 mutants | KILLED 409 | TIMED_OUT 1 | SURVIVED 10 | NO_COVERAGE 0
              mutation score   97.38 %  (KILLED only; pitest's headline reads 97.62 %
                                         because it scores the one TIMED_OUT as a kill)
              test strength    97.38 %  (KILLED only; same headline caveat)
              pitest line cov  96.49 %  (824/854 lines of the mutated classes)
              JaCoCo line cov  96.92 %  (786/811)

            The pitest floors are set against the KILLED-ONLY rates rather than pitest's
            headline: a floor met by a mutant that hangs has not been met by an assertion.
            The single TIMED_OUT is genuine non-termination - the mutated thread factory
            returns null, the worker pool never starts a task, and the parse never returns.

            The ten residual survivors are all equivalent mutants: boundary flips whose
            off-by-one case cannot occur. `read <= 0` / `n <= 0` guard channel reads that
            return -1 or a positive count and never 0; `pos < end`, `pos >= end`,
            `start >= end` and `remaining <= 0` all take the same route through an empty
            slice when the two sides are equal; `rowsStart < 0` guards a char-backed parser,
            which reports -1 and never 0; and `i < n` in the split loop would compute a
            further boundary that already equals `end`. See
            plans/PLAN-clinical-path-test-strength.md, wave 0, for the per-mutant argument.

            The floors are a ratchet: if a later change drops the module below one of them,
            the change is wrong or a test is missing - the floor is not.

            Never pass these on the command line. A CLI -D clobbers every module's override
            at once.
        -->
        <jacoco.line.coverage>0.94</jacoco.line.coverage>
        <pitest.mutation.target>95</pitest.mutation.target>
        <pitest.coverage.target>94</pitest.coverage.target>
        <pitest.test.strength.target>95</pitest.test.strength.target>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- JSpecify nullability annotations (NullAway). -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <reporting>
    </reporting>

</project>
